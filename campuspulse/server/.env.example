PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/CampusPulse
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
COOKIE_NAME=campuspulse_token
CLIENT_URL=http://localhost:5173

# Google OAuth (required only for Google login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# GitHub OAuth (required only for GitHub login)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback

# Facebook OAuth (required only for Facebook login)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:5000/api/auth/facebook/callback

# REAL Gemini AI Agent (keep key server-side; never put it in frontend)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
